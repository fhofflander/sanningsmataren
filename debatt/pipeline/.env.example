# Copy to .env (gitignored). Loaded by debatt.config on startup.

# Azure AI Speech (fast transcription API). EU region for data residency,
# e.g. swedencentral or westeurope.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral

# Anthropic API key. Used for speaker mapping (Phase 1) and
# extraction/verification (Phase 2).
ANTHROPIC_API_KEY=

# Optional overrides
# DEBATT_DATA_DIR=../data
# DEBATT_EXTRACT_MODEL=claude-haiku-4-5-20251001
# DEBATT_VERIFY_MODEL=claude-sonnet-4-6
