# --- Frontend (Vite, baked into the bundle) ---
# Base URL for published JSON/media. Empty = same origin (dev/demo).
# VITE_DATA_BASE_URL=https://media.example.se

# --- Admin API (Vercel serverless functions, server-side only) ---
# Admin accounts: username:bcrypt-hash pairs, comma-separated.
# Generate hashes locally with: node scripts/hash-password.mjs
# ADMIN_USERS=jonathan:$2b$12$...,fredrik:$2b$12$...

# Session signing secret: any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# Cloudflare R2 (EU jurisdiction buckets). Create an API token scoped to the
# two buckets with Object Read & Write.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRIVATE_BUCKET=sanningsmataren-debatt-private
# R2_PUBLIC_BUCKET=sanningsmataren-debatt-public

# Public custom domain connected to the public bucket (no trailing slash).
# PUBLIC_MEDIA_BASE_URL=https://media.example.se
