# Dependencies
node_modules

# Build output
dist
dist-ssr
dist-extension
*.tsbuildinfo

# Local env files - NEVER commit real API keys.
# Vite loads .env*.local; *.development.local is dev-only and is never
# inlined into a production build.
.env
.env.*
!.env.example

# Debattanalys module: per-debate working data (video/audio/transcripts)
# and the local Python environment are never committed.
debatt/data/
debatt/pipeline/.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
*.local
